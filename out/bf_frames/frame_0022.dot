digraph G {
  label="Iter. 2: Checando C->B";
  labelloc=top;
  fontsize=20;
  rankdir=LR;
  graph [pad="0.2", nodesep="0.5", ranksep="0.5", overlap=false, splines=true];
  node [shape=circle, style=filled, fillcolor=white, fontsize=12, fontname="Helvetica"];
  edge [fontsize=10, fontname="Helvetica"];

  "A";
  "B";
  "C";
  "D";
  "E";
  "F";
  "S";


  "S" -> "A" [label="4" color=gray];
  "S" -> "B" [label="2" color=gray];
  "A" -> "C" [label="3" color=green, penwidth=2.5];
  "B" -> "A" [label="1" color=gray];
  "B" -> "D" [label="4" color=gray];
  "A" -> "D" [label="2" color=green, penwidth=2.5];
  "D" -> "E" [label="2" color=gray];
  "C" -> "E" [label="-5" color=green, penwidth=2.5];
  "E" -> "F" [label="3" color=green, penwidth=2.5];
  "C" -> "B" [label="1" color=blue, penwidth=3.0, style=dashed];
}
